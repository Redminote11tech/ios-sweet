From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 14:48:00 +0100
Subject: [PATCH] 0113

---
 bsd/dev/sweet_sample.c | 15 ++++++++++
 osfmk/kern/exception.c | 67 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 82 insertions(+)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index 386dbb4..bad4f73 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -26,6 +26,8 @@ extern void sweet_sample_start(void);
 #if SWEET_ARMV80
 extern void sweet_lse_stats(void);
 #endif
+extern void sweet_report_cpus(void);
+extern void sweet_report_task_kernel(int pid, task_t task);
 
 static char sweet_sample_names[128];
 
@@ -79,6 +81,19 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 #if SWEET_ARMV80
 		sweet_lse_stats();
 #endif
+		sweet_report_cpus();
+		{
+			proc_t init = proc_find(1);
+			if (init != PROC_NULL) {
+				task_t t = proc_task(init);
+				if (t != TASK_NULL) {
+					sweet_report_task_kernel(1, t);
+				}
+				proc_rele(init);
+			} else {
+				printf("CPUR no pid 1 yet\n");
+			}
+		}
 		proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
 		(void)tsleep(&chan, PZERO, "sweetsmp", 120 * hz);
 	}
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a20a764..a593784 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1132,3 +1132,70 @@ sys_perf_notify(thread_t thread, int pid)
 
 	return ret;
 }
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <arm/cpu_data_internal.h>
+#include <kern/processor.h>
+#include <mach/vm_param.h>
+
+/*
+ * SWEET 8-core hang report: per CPU interrupt counters and current thread,
+ * then every thread of `task` (pid 1 while init is stuck) with its state,
+ * wait event, last CPU and kernel frame-pointer backtrace (unslide with the
+ * printed kernel slide, symbolicate against kernel.development.sweet).
+ */
+void sweet_report_cpus(void);
+void sweet_report_task_kernel(int pid, task_t task);
+
+void
+sweet_report_cpus(void)
+{
+	printf("CPUR kernel slide 0x%lx\n", vm_kernel_slide);
+	for (int i = 0; i < MAX_CPUS; i++) {
+		cpu_data_t *cd = cpu_datap(i);
+		if (cd == NULL) {
+			continue;
+		}
+		thread_t t = cd->cpu_active_thread;
+		printf("CPUR cpu%d running %d irq %llu ipi %llu timer %llu signal 0x%x thread 0x%llx pid %d%s\n",
+		    i, cd->cpu_running, cd->cpu_stat.irq_ex_cnt, cd->cpu_stat.ipi_cnt, cd->cpu_stat.timer_cnt,
+		    cd->cpu_signal, t ? thread_tid(t) : 0ULL,
+		    (t && get_threadtask(t)) ? task_pid(get_threadtask(t)) : -1,
+		    (t && cpu_to_processor(i) && t == cpu_to_processor(i)->idle_thread) ? " (idle)" : "");
+	}
+}
+
+void
+sweet_report_task_kernel(int pid, task_t task)
+{
+	thread_t thread;
+	int tn = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		char line[480];
+		int n = snprintf(line, sizeof(line), "CPUR pid %d t%d tid 0x%llx state 0x%x pri %d wait 0x%llx last cpu %d",
+		    pid, tn++, thread_tid(thread), thread->state, thread->sched_pri, (uint64_t)thread->wait_event,
+		    thread->last_processor ? thread->last_processor->cpu_id : -1);
+		vm_offset_t ks = thread->kernel_stack;
+		if (ks != 0 && !(thread->state & TH_RUN)) {
+			machine_thread_kernel_state *ctx = &thread_get_kernel_state(thread)->machine;
+			uint64_t fp = ctx->ss.fp;
+			vm_offset_t lo = ks;
+			vm_offset_t hi = ks + kernel_stack_size;
+			n += snprintf(line + n, sizeof(line) - n, " kbt 0x%llx", ctx->ss.lr);
+			for (int i = 0; i < 20 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0 &&
+			    n < (int)sizeof(line) - 24; i++) {
+				uint64_t *f = (uint64_t *)fp;
+				n += snprintf(line + n, sizeof(line) - n, " 0x%llx", f[1]);
+				if (f[0] <= fp) {
+					break;
+				}
+				fp = f[0];
+			}
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
