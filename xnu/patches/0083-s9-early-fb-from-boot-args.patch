 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+/*
+ * Geometry comes from boot_args->Video via sweet_early_set_fb(), called first
+ * thing in arm_init(); these defaults are the Redmi Note 10 Pro panel.
+ */
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
