+#define EARLY_WIDTH early_width
+#define EARLY_HEIGHT early_height
+#define EARLY_STRIDE early_stride
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
@@ -125,6 +130,19 @@ sweet_early_panic(const char *fmt, va_list *args)
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
+void
+sweet_early_set_fb(uint64_t pa, uint64_t width, uint64_t height, uint64_t row_bytes)
+{
+	/* Ignore an empty or implausible description; keep the defaults. */
+	if (pa == 0 || width < 64 || height < 64 || row_bytes < width * 4) {
+		return;
+	}
+	early_fb = (volatile uint32_t *)(uintptr_t)pa;
+	early_width = (unsigned int)width;
+	early_height = (unsigned int)height;
+	early_stride = (unsigned int)(row_bytes / 4);
+}
