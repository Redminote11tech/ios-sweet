From 47d6b638a6972127197a34697d9a7b9b4d1a8d25 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 16:43:09 +0100
Subject: [PATCH] s9: RAM shadow default framebuffer surface (GPU-renderable)

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 22 +++++++++++++++++---
 iokit/Kernel/arm/SweetSurface.cpp     | 30 +++++++++++++++++++++++++++
 iokit/Kernel/arm/SweetSurface.h       |  7 +++++++
 3 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index dea4e65..697e05b 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -115,6 +115,7 @@ public:
 	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
 	IOMemoryMap  *fMap;
 	SweetSurface *fSurface;         /* the panel memory as an IOSurface */
+	SweetSurface *fDefault;         /* layer default surface: fSurface or a RAM shadow */
 	IOLock       *fLock;            /* swaps and client list */
 	OSArray      *fClients;
 	uint32_t      fSwapID;
@@ -234,7 +235,22 @@ AppleCLCD::start(IOService *provider)
 	 * panel stride), so backboardd sees one display size everywhere.
 	 * fPixels stays the start of the panel memory.
 	 */
-	if (fSurface != NULL && fOffX <= 0 && fOffY <= 0 && (fOffX < 0 || fOffY < 0)) {
+	int shadow = 1;
+	PE_parse_boot_argn("sweetfb_shadow", &shadow, sizeof(shadow));
+	fDefault = fSurface;
+	if (fSurface != NULL && (fOffX < 0 || fOffY < 0) && shadow) {
+		/*
+		 * The panel window (stride 5760, offset not 64-byte aligned) cannot
+		 * be a GPU render target, and CA renders into the default surface:
+		 * give it a RAM surface of the presented size instead, presented
+		 * (copied/scaled) like any other layer.
+		 */
+		fDefault = sweet_surface_create_buffer(fLogicalW, fLogicalH, SWEET_FB_FORMAT_BGRA);
+		if (fDefault == NULL) {
+			fDefault = fSurface;
+		}
+	}
+	if (fDefault == fSurface && fSurface != NULL && fOffX <= 0 && fOffY <= 0 && (fOffX < 0 || fOffY < 0)) {
 		fSurface->width = fLogicalW;
 		fSurface->height = fLogicalH;
 		fSurface->offset = (uint32_t)(-fOffY) * fRowBytes + (uint32_t)(-fOffX) * 4;
@@ -268,7 +284,7 @@ AppleCLCD::start(IOService *provider)
 	}
 	OSSafeReleaseNULL(es);
 	IOLog("SWEET FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
-	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+	    fWidth, fHeight, fRowBytes, fPhys, fDefault->id, fLogicalW, fLogicalH);
 	return true;
 }
 
@@ -650,7 +666,7 @@ IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMetho
 
 	switch (selector) {
 	case kSweetFBGetLayerDefaultSurface:
-		out[0] = sweet_surface_port_in_task(fFB->fSurface, fTask);
+		out[0] = sweet_surface_port_in_task(fFB->fDefault, fTask);
 		outCount = 1;
 		break;
 	case kSweetFBSwapBegin:
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index e564e9f..858ba9f 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -203,6 +203,8 @@ sweet_surface_init_lock(void)
 	}
 }
 
+static uint32_t sweet_row_align(uint64_t row);
+
 static SweetSurface *
 sweet_surface_alloc(void)
 {
@@ -256,6 +258,34 @@ sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
 	return s;
 }
 
+SweetSurface *
+sweet_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = sweet_row_align((uint64_t)width * 4);
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page((uint64_t)s->bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	if (mem != NULL) {
+		bzero(mem->getBytesNoCopy(), s->allocSize);
+	}
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
 mach_port_name_t
 sweet_surface_port_in_task(SweetSurface *s, task_t task)
 {
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index 41be9ea..69bbedc 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -60,6 +60,13 @@ SweetSurface *sweet_surface_copy(uint32_t id);
 SweetSurface *sweet_surface_create_physical(uint64_t phys, uint32_t width,
     uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
 
+/*
+ * Publish a new zeroed RAM surface (64-byte aligned rows, cacheable), for
+ * a default surface the GPU can render into. Retained, as above.
+ */
+SweetSurface *sweet_surface_create_buffer(uint32_t width, uint32_t height,
+    uint32_t pixelFormat);
+
 /* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
 mach_port_name_t sweet_surface_port_in_task(SweetSurface *surface, task_t task);
 
-- 
2.43.0

