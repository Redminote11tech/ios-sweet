@@ -41,6 +41,22 @@ extern "C" void proc_selfname(char *buf, int size);
 #define SWEET_GPU_CLIENT_BYTES  (768ull << 20)     /* own buffers per client */
 
 extern "C" void flush_dcache64(addr64_t addr, unsigned count, int phys);
+extern "C" boolean_t pmap_valid_address(uint64_t addr);
+
+/*
+ * Physical cache maintenance only on kernel-managed RAM: phys flushes go
+ * through the physical aperture, which does not cover memory outside XNU's
+ * RAM such as the panel framebuffer at 0xcc000000 (a surface backboardd
+ * hands to the GPU: ios-ca2 panicked "phystokv_range: illegal PA
+ * 0xcc000000"). The kernel maps that memory uncached anyway.
+ */
+static void
+flush_pa(uint64_t pa)
+{
+	if (pmap_valid_address(pa)) {
+		flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	}
+}
 extern "C" boolean_t pmap_is_modified(ppnum_t pn);
 extern "C" void pmap_clear_modify(ppnum_t pn);
 extern "C" boolean_t pmap_valid_page(ppnum_t pn);
@@ -58,10 +74,10 @@ flush_if_written(uint64_t pa)
 {
 	ppnum_t pn = (ppnum_t)(pa >> PAGE_SHIFT);
 	if (!pmap_valid_page(pn)) {             /* not managed: no modified bit, always */
-		flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+		flush_pa(pa);
 	} else if (pmap_is_modified(pn)) {
 		pmap_clear_modify(pn);
-		flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+		flush_pa(pa);
 	}
 }
 
