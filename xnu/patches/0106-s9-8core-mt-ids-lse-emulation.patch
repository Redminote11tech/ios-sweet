diff --git a/osfmk/arm64/machine_routines_asm.s b/osfmk/arm64/machine_routines_asm.s
index 2449334..9454f11 100644
--- a/osfmk/arm64/machine_routines_asm.s
+++ b/osfmk/arm64/machine_routines_asm.s
@@ -614,6 +614,143 @@ LEXT(_copyout_atomic64)
 	POP_FRAME
 	ARM64_STACK_EPILOG
 
+#if SWEET_ARMV80
+/*
+ * S9 (Galaxy S9, Exynos 9810): the Mongoose M3 big cores are ARMv8.0 and
+ * have no LSE atomics, which iOS userland uses everywhere. sleh.c emulates
+ * a trapped user CAS / CASP / LD<op> / SWP with these exclusive loops on
+ * the user address (PAN is off on this build). A fault on the user page is
+ * resolved by vm_fault and the loop restarts (the exception clears the
+ * exclusive monitor); an unresolvable one returns EFAULT.
+ *
+ * int _sweet_lse_cas{b,h,w,x}(user_addr_t a, uint64_t cmp, uint64_t new, uint64_t *old)
+ * int _sweet_lse_ldop{b,h,w,x}(user_addr_t a, uint64_t opnd, uint32_t op, uint64_t *old)
+ *   op: 0 add 1 clr 2 eor 3 set 4 smax 5 smin 6 umax 7 umin 8 swp
+ *   (cmp / opnd / new must already be zero-extended to the access size)
+ * int _sweet_lse_casp{w,x}(user_addr_t a, uint64_t c0, uint64_t c1, uint64_t n0, uint64_t n1, uint64_t *old2)
+ */
+.macro SWEET_LSE_CAS name, ld, st, r
+	.text
+	.align 2
+	.globl EXT(\name)
+LEXT(\name)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	COPYIO_RECOVER_RANGE Lcas_done\@
+Lcas_loop\@:
+	\ld		\r\()8, [x0]
+	cmp		x8, x1
+	b.ne	Lcas_fail\@
+	\st		w9, \r\()2, [x0]
+	cbnz	w9, Lcas_loop\@
+	b		Lcas_done\@
+Lcas_fail\@:
+	clrex
+Lcas_done\@:
+	dmb		ish
+	str		x8, [x3]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+.endmacro
+
+.macro SWEET_LSE_LDOP name, ld, st, r, bits
+	.text
+	.align 2
+	.globl EXT(\name)
+LEXT(\name)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	sbfx	x12, x1, #0, #\bits
+	COPYIO_RECOVER_RANGE Lop_done\@
+Lop_loop\@:
+	\ld		\r\()8, [x0]
+	sbfx	x11, x8, #0, #\bits
+	mov		x10, x1						// swp (op 8)
+	cmp		w2, #0
+	b.ne	1f
+	add		x10, x8, x1
+	b		Lop_store\@
+1:	cmp		w2, #1
+	b.ne	1f
+	bic		x10, x8, x1
+	b		Lop_store\@
+1:	cmp		w2, #2
+	b.ne	1f
+	eor		x10, x8, x1
+	b		Lop_store\@
+1:	cmp		w2, #3
+	b.ne	1f
+	orr		x10, x8, x1
+	b		Lop_store\@
+1:	cmp		w2, #4
+	b.ne	1f
+	cmp		x11, x12
+	csel	x10, x8, x1, gt
+	b		Lop_store\@
+1:	cmp		w2, #5
+	b.ne	1f
+	cmp		x11, x12
+	csel	x10, x8, x1, lt
+	b		Lop_store\@
+1:	cmp		w2, #6
+	b.ne	1f
+	cmp		x8, x1
+	csel	x10, x8, x1, hi
+	b		Lop_store\@
+1:	cmp		w2, #7
+	b.ne	Lop_store\@
+	cmp		x8, x1
+	csel	x10, x8, x1, lo
+Lop_store\@:
+	\st		w9, \r\()10, [x0]
+	cbnz	w9, Lop_loop\@
+Lop_done\@:
+	dmb		ish
+	str		x8, [x3]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+.endmacro
+
+.macro SWEET_LSE_CASP name, r
+	.text
+	.align 2
+	.globl EXT(\name)
+LEXT(\name)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	COPYIO_RECOVER_RANGE Lcasp_done\@
+Lcasp_loop\@:
+	ldaxp	\r\()8, \r\()9, [x0]
+	cmp		x8, x1
+	ccmp	x9, x2, #0, eq
+	b.ne	Lcasp_fail\@
+	stlxp	w10, \r\()3, \r\()4, [x0]
+	cbnz	w10, Lcasp_loop\@
+	b		Lcasp_done\@
+Lcasp_fail\@:
+	clrex
+Lcasp_done\@:
+	dmb		ish
+	stp		x8, x9, [x5]
+	mov		x0, #0
+	POP_FRAME
+	ARM64_STACK_EPILOG
+.endmacro
+
+	SWEET_LSE_CAS	_sweet_lse_casb, ldaxrb, stlxrb, w
+	SWEET_LSE_CAS	_sweet_lse_cash, ldaxrh, stlxrh, w
+	SWEET_LSE_CAS	_sweet_lse_casw, ldaxr, stlxr, w
+	SWEET_LSE_CAS	_sweet_lse_casx, ldaxr, stlxr, x
+	SWEET_LSE_LDOP	_sweet_lse_ldopb, ldaxrb, stlxrb, w, 8
+	SWEET_LSE_LDOP	_sweet_lse_ldoph, ldaxrh, stlxrh, w, 16
+	SWEET_LSE_LDOP	_sweet_lse_ldopw, ldaxr, stlxr, w, 32
+	SWEET_LSE_LDOP	_sweet_lse_ldopx, ldaxr, stlxr, x, 64
+	SWEET_LSE_CASP	_sweet_lse_caspw, w
+	SWEET_LSE_CASP	_sweet_lse_caspx, x
+#endif /* SWEET_ARMV80 */
+
 
 /*
  * int _bcopyout(const char *src, char *dst, vm_size_t len)
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
index 0fc70fe..4e96b80 100644
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -875,6 +875,159 @@ sleh_synchronous(arm_context_t *context, uint32_t esr, vm_offset_t far)
 #endif
 }
 
+#if SWEET_ARMV80
+/*
+ * S9: the Mongoose M3 big cores (ARMv8.0) lack the ARMv8.1 LSE atomics
+ * that iOS 16 userland (built for the A11, ARMv8.2) uses everywhere.
+ * A user CAS/CASP/LD<op>/SWP that traps as undefined is performed here
+ * with exclusive loads/stores on the same address (machine_routines_asm.s)
+ * and the thread continues after it. Any other undefined user instruction
+ * on a big core (some other ARMv8.1+ instruction) moves the thread to the
+ * little A55 cores for good and retries it there.
+ */
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+extern int proc_selfpid(void);
+extern int _sweet_lse_casb(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _sweet_lse_cash(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _sweet_lse_casw(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _sweet_lse_casx(user_addr_t, uint64_t, uint64_t, uint64_t *);
+extern int _sweet_lse_ldopb(user_addr_t, uint64_t, uint32_t, uint64_t *);
+extern int _sweet_lse_ldoph(user_addr_t, uint64_t, uint32_t, uint64_t *);
+extern int _sweet_lse_ldopw(user_addr_t, uint64_t, uint32_t, uint64_t *);
+extern int _sweet_lse_ldopx(user_addr_t, uint64_t, uint32_t, uint64_t *);
+extern int _sweet_lse_caspw(user_addr_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t *);
+extern int _sweet_lse_caspx(user_addr_t, uint64_t, uint64_t, uint64_t, uint64_t, uint64_t *);
+
+static int sweet_lse_emul = 1;
+static uint64_t sweet_lse_count, sweet_lse_moved;
+
+static inline uint64_t
+sweet_xreg(arm_saved_state_t *state, unsigned r)
+{
+	return r == 31 ? 0 : (uint64_t)get_saved_state_reg(state, r);
+}
+
+static inline void
+sweet_set_xreg(arm_saved_state_t *state, unsigned r, uint64_t v)
+{
+	if (r != 31) {
+		set_saved_state_reg(state, r, (register_t)v);
+	}
+}
+
+static inline bool
+sweet_on_big_core(void)
+{
+	return ((__builtin_arm_rsr64("MIDR_EL1") >> 24) & 0xff) == 0x53;   /* Samsung */
+}
+
+/* 0 = emulated (pc advanced), EFAULT = bad user address, -1 = not LSE */
+static int
+sweet_lse_emulate(arm_saved_state_t *state, uint32_t instr, user_addr_t *addr)
+{
+	unsigned rt = instr & 31, rn = (instr >> 5) & 31, rs = (instr >> 16) & 31;
+	unsigned size = instr >> 30;
+	user_addr_t a = rn == 31 ? (user_addr_t)get_saved_state_sp(state) : (user_addr_t)sweet_xreg(state, rn);
+	uint64_t mask = size == 3 ? ~0ULL : ((1ULL << (8 << size)) - 1);
+	uint64_t old = 0, oldp[2] = {0, 0};
+	int err;
+
+	*addr = a;
+
+	if ((instr & 0x3FA07C00) == 0x08A07C00) {                   /* CAS{A}{L}{B,H} */
+		uint64_t cmp = sweet_xreg(state, rs) & mask, nv = sweet_xreg(state, rt) & mask;
+		switch (size) {
+		case 0: err = _sweet_lse_casb(a, cmp, nv, &old); break;
+		case 1: err = _sweet_lse_cash(a, cmp, nv, &old); break;
+		case 2: err = _sweet_lse_casw(a, cmp, nv, &old); break;
+		default: err = _sweet_lse_casx(a, cmp, nv, &old); break;
+		}
+		if (err == 0) {
+			sweet_set_xreg(state, rs, old);
+		}
+	} else if ((instr & 0xBFA07C00) == 0x08207C00) {            /* CASP{A}{L} */
+		bool x = (instr >> 30) & 1;
+		uint64_t m = x ? ~0ULL : 0xffffffffULL;
+		if ((rs & 1) || (rt & 1)) {
+			return -1;
+		}
+		uint64_t c0 = sweet_xreg(state, rs) & m, c1 = sweet_xreg(state, rs + 1) & m;
+		uint64_t n0 = sweet_xreg(state, rt) & m, n1 = sweet_xreg(state, rt + 1) & m;
+		err = x ? _sweet_lse_caspx(a, c0, c1, n0, n1, oldp) : _sweet_lse_caspw(a, c0, c1, n0, n1, oldp);
+		if (err == 0) {
+			sweet_set_xreg(state, rs, oldp[0]);
+			sweet_set_xreg(state, rs + 1, oldp[1]);
+		}
+	} else if ((instr & 0x3F200C00) == 0x38200000) {            /* LD<op>{A}{L}, SWP{A}{L} */
+		unsigned o3 = (instr >> 15) & 1, opc = (instr >> 12) & 7;
+		uint32_t op;
+		if (o3) {
+			if (opc != 0) {
+				return -1;                                  /* LDAPR (v8.3) etc. */
+			}
+			op = 8;
+		} else {
+			op = opc;
+		}
+		uint64_t v = sweet_xreg(state, rs) & mask;
+		switch (size) {
+		case 0: err = _sweet_lse_ldopb(a, v, op, &old); break;
+		case 1: err = _sweet_lse_ldoph(a, v, op, &old); break;
+		case 2: err = _sweet_lse_ldopw(a, v, op, &old); break;
+		default: err = _sweet_lse_ldopx(a, v, op, &old); break;
+		}
+		if (err == 0) {
+			sweet_set_xreg(state, rt, old);
+		}
+	} else {
+		return -1;
+	}
+	if (err == 0) {
+		add_saved_state_pc(state, 4);
+		if (sweet_lse_count++ == 0) {
+			printf("sweet: emulating LSE atomics on the M3 cores (first: %08x)\n", instr);
+		}
+	}
+	return err;
+}
+
+/* true if handled: the thread continues (emulated, or moved to a little core to retry) */
+static bool
+sweet_big_core_undef(arm_saved_state_t *state, uint32_t instr)
+{
+	if (!sweet_lse_emul || !PSR64_IS_USER64(get_saved_state_cpsr(state)) || !sweet_on_big_core()) {
+		return false;
+	}
+	user_addr_t a = 0;
+	int r = sweet_lse_emulate(state, instr, &a);
+	if (r == 0) {
+		return true;
+	}
+	if (r == EFAULT) {
+		/* like a bad atomic access on a real LSE core: SIGBUS/SIGSEGV via EXC_BAD_ACCESS */
+		mach_exception_data_type_t codes[2] = {KERN_INVALID_ADDRESS, (mach_exception_data_type_t)a};
+		exception_triage(EXC_BAD_ACCESS, codes, 2);
+		__builtin_unreachable();
+	}
+	/* another ARMv8.1+ instruction: retry it on a little core (cpus 0-3 are the A55s) */
+	if (!ml_get_interrupts_enabled()) {
+		return false;
+	}
+	processor_t p = cpu_to_processor((int)(sweet_lse_moved++ & 3));
+	if (p == PROCESSOR_NULL) {
+		return false;
+	}
+	if (sweet_lse_moved <= 20) {
+		printf("sweet: undefined %08x on an M3 core, pid %d moved to a little core\n", instr,
+		    proc_selfpid());
+	}
+	thread_bind(p);
+	thread_block(THREAD_CONTINUE_NULL);
+	return true;
+}
+#endif /* SWEET_ARMV80 */
+
 /*
  * Uncategorized exceptions are a catch-all for general execution errors.
  * ARM64_TODO: For now, we assume this is for undefined instruction exceptions.
@@ -889,6 +1042,12 @@ handle_uncategorized(arm_saved_state_t *state)
 
 	COPYIN(get_saved_state_pc(state), (char *)&instr, sizeof(instr));
 
+#if SWEET_ARMV80
+	if (sweet_big_core_undef(state, instr)) {
+		return;
+	}
+#endif
+
 #if CONFIG_DTRACE
 
 	if (PSR64_IS_USER64(get_saved_state_cpsr(state))) {
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 52c7cf0..ebd7e0d 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -143,7 +143,9 @@ LEXT(reset_vector)
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
 	add		x19, x19, EXT(ResetHandlerData)@pageoff
 	mrs		x15, MPIDR_EL1						// Load MPIDR to get CPU number
-#if HAS_CLUSTER || defined(SWEET)
+#if SWEET_ARMV80
+	and		x0, x15, #0x1FFFFFF				// S9: MT + Aff2:Aff1:Aff0 (A55 0x1000n00, M3 0x10n)
+#elif HAS_CLUSTER || defined(SWEET)
 	and		x0, x15, #0xFFFF					// Full Aff1:Aff0 (SWEET: core in Aff1)
 #else
 	and		x0, x15, #0xFF						// CPU number is in MPIDR Affinity Level 0
-- 
