+#if SWEET_ARMV80
+/*
+ * Galaxy S9 Mongoose M3 cluster: Samsung's pmucal_lpm_init CPUCL1 defaults
+ * (as galaxy-s9plus-mainline-linux applies before PSCI CPU_ON; S-Boot leaves
+ * them at reset values and then CPU_ON(0x100+n) never returns). PMU
+ * 0x14060000: CPU_QCH_CLUSTER1_NONCPU_SYS_PWR_REG [31:24] = 0x8d,
+ * MEMORY_CLUSTER1_CPU0..3_OPTION and NONCPU_OPTION [1:0] = 2. Verified with
+ * the shim's t13 probe: all four M3 cores start (2026-10-27).
+ */
+static void
+sweet_m3_pmu_defaults(void)
+{
+	static bool done;
+	static const struct {
+		uint32_t off, mask, val;
+	} seq[] = {
+		{ 0x1088, 0xff000000, 0x8d000000 },
+		{ 0x2114, 3, 2 }, { 0x2180, 3, 2 }, { 0x21ec, 3, 2 }, { 0x2258, 3, 2 },
+		{ 0x2384, 3, 2 },
+	};
+	if (done) {
+		return;
+	}
+	volatile uint32_t *pmu = (volatile uint32_t *)ml_io_map(0x14060000, 0x4000);
+	if (pmu == NULL) {
+		panic("SWEET CPU: cannot map the PMU");
+	}
+	for (unsigned i = 0; i < sizeof(seq) / sizeof(seq[0]); i++) {
+		uint32_t before = pmu[seq[i].off / 4];
+		pmu[seq[i].off / 4] = (before & ~seq[i].mask) | seq[i].val;
+		IOLog("SWEET CPU: M3 PMU %04x: %08x -> %08x\n", seq[i].off, before, pmu[seq[i].off / 4]);
+	}
+	__builtin_arm_dsb(DSB_SY);
+	done = true;
+}
+#endif
+
 kern_return_t
 SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 {
 	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
 	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
-	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	if (start_paddr != 0 || arg_paddr != 0 || cpu->cpu_id == 0 ||
 	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
 		panic("SWEET CPU: cpu=%u unsupported restart", getCPUNumber());
 	}
@@ -272,6 +318,11 @@ SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 		    getCPUNumber(), tpa, (uint64_t)entry);
 		entry = (vm_offset_t)tpa;
 	}
+#if SWEET_ARMV80
+	if ((target & ~3ULL) == 0x100) {
+		sweet_m3_pmu_defaults();
+	}
+#endif
 	IOLog("SWEET CPU: cpu=%u CPU_ON mpidr=0x%x target=0x%llx entry_pa=0x%llx context=%u\n",
 	    getCPUNumber(), cpu->phys_id, target, (uint64_t)entry, getCPUNumber());
 	__builtin_arm_dsb(DSB_SY);
