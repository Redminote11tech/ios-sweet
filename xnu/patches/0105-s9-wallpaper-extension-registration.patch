diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index aa121aa..e26c132 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -320,6 +320,24 @@ sweet_amfi_syscall(__unused struct proc *p, int call, user_addr_t arg)
 {
 	uint64_t a[2], flags = SWEET_AMFI_DYLD_FLAGS;
 
+	if (call == 0x60) {
+		/*
+		 * amfi_interface_query_bootarg_state(u64 *state): 0x86 as bergamota /
+		 * iOSPlus10 answer it. ExtensionFoundation (lsd) then reads the
+		 * extension point cache without the AMFI signature check; without an
+		 * answer the catalog stays empty and no app extension (wallpaper
+		 * posters, widgets) is registered.
+		 */
+		uint64_t state = 0x86;
+		static int logged;
+		if (!logged) {
+			logged = 1;
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			printf("SWEET AMFI: %s asks op 0x60 (boot-arg state), answer 0x86\n", name);
+		}
+		return arg == 0 ? EFAULT : copyout(&state, arg, sizeof(state));
+	}
 	if (call != 0x5a) {
 		return ENOPOLICY;
 	}
diff --git a/iokit/Kernel/arm/SweetAMFI.cpp b/iokit/Kernel/arm/SweetAMFI.cpp
new file mode 100644
index 0000000..43afe18
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAMFI.cpp
@@ -0,0 +1,85 @@
+/*
+ * Built-in AppleMobileFileIntegrity IOService for SWEET (S9 port).
+ *
+ * ExtensionFoundation (lsd) checks the signed extension cache
+ * (/System/Library/xpc/extensions.plist) through this service: user client
+ * selector 6 (trust cache query: 1 scalar + cdhash) must succeed, or the
+ * extension point catalog stays empty and no app extension (wallpaper
+ * posters, widgets) is ever registered. Every cdhash answers "trusted";
+ * other selectors are logged once and fail with kIOReturnUnsupported.
+ *
+ * Same idea as ios-flame 0103 / iOSPlus10 0221 (MIT); written for SWEET.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("SWEET AMFI: AppleMobileFileIntegrity published (trust cache queries answer trusted)\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t sweet_amfi_uc_logged;   /* one bit per selector < 64 */
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = selector == 6 ? kIOReturnSuccess : kIOReturnUnsupported;
+	if (selector == 6) {
+		args->scalarOutputCount = 0;
+	}
+	uint64_t bit = selector < 64 ? 1ULL << selector : 0;
+	if (bit == 0 || (__atomic_fetch_or(&sweet_amfi_uc_logged, bit, __ATOMIC_RELAXED) & bit) == 0) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		uint32_t in_struct = args->structureInputDescriptor != NULL ?
+		    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+		IOLog("SWEET AMFI: %s user client sel %u in %u/%u out %u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, in_struct, args->scalarOutputCount, ret);
+	}
+	return ret;
+}
+#endif /* SWEET */
