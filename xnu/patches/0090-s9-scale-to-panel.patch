+/*
+ * One layer, logical rect (dx,dy,w,h) from surface position (sx,sy), scaled
+ * to the panel: panel row py shows logical row (py * fInv) >> 16, panel
+ * column fDstX0 + px shows logical column (px * fInv) >> 16.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	static uint16_t colmap[4096];
+	uintptr_t src = s->kernelAddress();
+	uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+
+	if (dx < 0) {
+		sx -= dx;
+		w += dx;
+		dx = 0;
+	}
+	if (dy < 0) {
+		sy -= dy;
+		h += dy;
+		dy = 0;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (src == 0 || bpe != 4 || w <= 0 || h <= 0 || s->elementWidth != 1 ||
+	    s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	/* panel ranges whose logical source falls inside the layer */
+	int32_t px0 = (int32_t)(((uint64_t)dx << 16) / fInv), px1 = (int32_t)(((uint64_t)(dx + w) << 16) / fInv);
+	int32_t py0 = (int32_t)(((uint64_t)dy << 16) / fInv), py1 = (int32_t)(((uint64_t)(dy + h) << 16) / fInv);
+	while (px0 > 0 && (int32_t)(((uint64_t)px0 * fInv) >> 16) >= dx) {
+		px0--;
+	}
+	while ((int32_t)(((uint64_t)px0 * fInv) >> 16) < dx) {
+		px0++;
+	}
+	while ((int32_t)(((uint64_t)py0 * fInv) >> 16) < dy) {
+		py0++;
+	}
+	while (py0 > 0 && (int32_t)(((uint64_t)(py0 - 1) * fInv) >> 16) >= dy) {
+		py0--;
+	}
+	if (px1 > fDstW) {
+		px1 = fDstW;
+	}
+	if (py1 > (int32_t)fHeight) {
+		py1 = (int32_t)fHeight;
+	}
+	int32_t n = px1 - px0;
+	if (n <= 0 || py1 <= py0 || n > 4096) {
+		return;
+	}
+	for (int32_t i = 0; i < n; i++) {
+		int32_t lx = (int32_t)(((uint64_t)(px0 + i) * fInv) >> 16);
+		lx = lx < dx ? dx : (lx >= dx + w ? dx + w - 1 : lx);
+		colmap[i] = (uint16_t)(sx + (lx - dx));
+	}
+	const uint8_t *base = (const uint8_t *)(src + s->offset);
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (int32_t)(((uint64_t)py * fInv) >> 16);
+		ly = ly < dy ? dy : (ly >= dy + h ? dy + h - 1 : ly);
+		const uint32_t *srow = (const uint32_t *)(base + (uint64_t)(sy + (ly - dy)) * s->bytesPerRow);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes) + fDstX0 + px0;
+		for (int32_t i = 0; i < n; i++) {
+			drow[i] = srow[colmap[i]];
+		}
+	}
+}
